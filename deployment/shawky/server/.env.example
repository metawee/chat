# ===== Server =====
# DNS A record of this domain must point to the server IP before starting (Caddy issues the TLS certificate).
DOMAIN=web.shawkygroup.com
# Local port for the reverse proxy (aaPanel site -> http://127.0.0.1:3000)
RAILS_PORT=3000
FRONTEND_URL=https://web.shawkygroup.com
# openssl rand -hex 64
SECRET_KEY_BASE=
DEFAULT_LOCALE=ar
ENABLE_ACCOUNT_SIGNUP=false
FORCE_SSL=true
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# ===== Database / Redis =====
POSTGRES_HOST=postgres
POSTGRES_USERNAME=chatwoot
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 24 — put the same value inside REDIS_URL
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME_SAME_AS_REDIS_PASSWORD@redis:6379

# ===== Email (password resets, notifications, delay alerts) =====
MAILER_SENDER_EMAIL=Shawky WhatsApp <no-reply@shawkygroup.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true

# ===== Media storage =====
# local = files on this server (volume "storage"). For Cloudflare R2 use s3_compatible:
ACTIVE_STORAGE_SERVICE=local
# ACTIVE_STORAGE_SERVICE=s3_compatible
# STORAGE_BUCKET_NAME=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=auto
# STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# ===== Shawky =====
SHAWKY_PHONE_MASKING=true
SHAWKY_ACCESS_CONTROL=true
SHAWKY_ROUTING=true
SHAWKY_INTEGRATIONS_ALLOWLIST=true
SHAWKY_ALLOWED_INTEGRATIONS=webhook
# Your office/VPN IPs, comma-separated (empty = no IP restriction on /super_admin)
SHAWKY_SUPER_ADMIN_ALLOWED_IPS=
SHAWKY_DISABLE_SIDEKIQ_WEB=true
SHAWKY_ATTACHMENT_URL_TTL_HOURS=24
# n8n
SHAWKY_UNMASKED_WEBHOOK_HOSTS=n8n.cws.social
SHAWKY_N8N_SECRET=
# Shawky gateway (system.shawkygroup.com): CRM buttons open /shawky/launch?session=...
SHAWKY_GATEWAY_LAUNCH=true
SHAWKY_GATEWAY_URL=https://system.shawkygroup.com
SHAWKY_GATEWAY_API_KEY=
# Dev/staging only: serve a mock gateway at /mock_gateway (set SHAWKY_GATEWAY_URL=<FRONTEND_URL>/mock_gateway).
SHAWKY_MOCK_GATEWAY=false
# CRM activities API (leave off until the CRM builds it)
SHAWKY_CRM_INTEGRATION=false
SHAWKY_CRM_BASE_URL=
SHAWKY_CRM_KEY_ID=
SHAWKY_CRM_SECRET=
SHAWKY_MOCK_CRM=false

# ---- Shawky staging (Phase 0) ----
# Public hostname pointing (DNS A record) at this server, e.g. staging-web.shawkygroup.com
STAGING_DOMAIN=staging-web.shawkygroup.com
FRONTEND_URL=https://staging-web.shawkygroup.com

# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=

DEFAULT_LOCALE=ar
ENABLE_ACCOUNT_SIGNUP=false
FORCE_SSL=true
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

POSTGRES_HOST=postgres
POSTGRES_USERNAME=chatwoot
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Generate with: openssl rand -hex 24 (same value in REDIS_URL)
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# Local disk for staging; production uses Cloudflare R2 (Phase 6)
ACTIVE_STORAGE_SERVICE=local

# Outgoing email (password resets, notifications). Fill from your SMTP provider.
MAILER_SENDER_EMAIL=Shawky Staging <no-reply@shawkygroup.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true

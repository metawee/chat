<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="no-referrer">
  <title><%= t('shawky.crm_launch.title', locale: :ar) %></title>
  <style>
    body { font-family: system-ui, sans-serif; background: #f8f6f1; color: #1f1f1f; margin: 0; display: flex; min-height: 100vh; align-items: center; justify-content: center; }
    main { background: #fff; border-top: 4px solid #b0881a; border-radius: 12px; padding: 32px; max-width: 440px; margin: 16px; box-shadow: 0 2px 12px rgba(0,0,0,.06); }
    h1 { font-size: 20px; margin: 0 0 12px; color: #8a6410; }
    p { line-height: 1.7; margin: 0 0 16px; }
    a { color: #8a6410; }
  </style>
</head>
<body>
  <main>
    <h1><%= t('shawky.crm_launch.title', locale: :ar) %></h1>
    <p><%= @message %></p>
    <a href="/app"><%= t('shawky.crm_launch.back', locale: :ar) %></a>
  </main>
</body>
</html>
